meta {
  name: Readiness Probe
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/readyz
  auth: none
}

assert {
  res.status: eq 200
  res.body.status: eq ready
  res.responseTime: lt 1000
}

tests {
  test("returns 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("body contains status ready", function() {
    const body = res.getBody();
    expect(body).to.have.property("status");
    expect(body.status).to.equal("ready");
  });

  test("responds within 1s", function() {
    expect(res.responseTime).to.be.below(1000);
  });
}
