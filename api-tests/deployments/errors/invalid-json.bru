meta {
  name: Invalid JSON Body
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/deployments
  auth: bearer
}

auth:bearer {
  token: {{oidcToken}}
}

headers {
  Content-Type: application/json
  X-Request-ID: bruno-test-err-bad-json
}

body:text {
  { this is not valid JSON }
}

assert {
  res.status: eq 400
  res.body.error.code: eq VALIDATION_ERROR
}

tests {
  test("returns 400 Bad Request", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("error code is VALIDATION_ERROR", function() {
    expect(res.getBody().error.code).to.equal("VALIDATION_ERROR");
  });

  test("error message mentions invalid request", function() {
    const msg = res.getBody().error.message.toLowerCase();
    expect(msg).to.include("invalid");
  });
}
